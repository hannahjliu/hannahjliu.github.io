{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 600,
  "height": 300,
  "title": {
    "text": "ICE Arrests by Area of Responsibility",
    "subtitle": {
      "expr": "'From ' + timeFormat(datetime(year(startDate), month(startDate), date(startDate)), '%b %d, %Y') + ' to ' + timeFormat(datetime(year(endDate), month(endDate), date(endDate)), '%b %d, %Y')"
    }
  },
  "params": [
    {
      "name": "startDate",
      "value": "2025-01-20",
      "bind": {
        "input": "date",
        "name": "Start Date:",
        "min": "2023-09-01",
        "max": "2026-08-06"
      }
    },
    {
      "name": "endDate",
      "value": "2026-09-01",
      "bind": {
        "input": "date",
        "name": "End Date:",
        "min": "2023-09-01",
        "max": "2026-08-06"
      }
    },
    {
      "name": "hoverAOR",
      "select": {
        "type": "point",
        "on": "pointerover",
        "clear": "pointerout",
        "fields": ["aor_nam"]
      }
    }
  ],
  "data": {
    "url": "https://raw.githubusercontent.com/hannahjliu/hannahjliu.github.io/refs/heads/main/ICEtracker/data/dailyarrests2025aor.csv",
    "format": {"type": "csv", "parse": {"Apprehension Date": "date"}}
  },
  "transform": [
    {
      "calculate": "datum.aor_nam == 'St. Paul' ? 'St Paul' : datum.aor_nam",
      "as": "aor_nam"
    },
    {"calculate": "toNumber(datum.arrests)", "as": "arrestsNum"},
    {
      "filter": "datum['Apprehension Date'] >= datetime(year(startDate), month(startDate), date(startDate)) && datum['Apprehension Date'] <= datetime(year(endDate), month(endDate), date(endDate))"
    },
    {
      "aggregate": [{"op": "sum", "field": "arrestsNum", "as": "totalArrests"}],
      "groupby": ["aor_nam"]
    },
    {
      "lookup": "aor_nam",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/hannahjliu/hannahjliu.github.io/refs/heads/main/visualizations/ice-aor-shp1.json",
          "format": {"feature": "ice-aor-shp", "type": "topojson"}
        },
        "key": "properties.aor_nam"
      },
      "as": "geo"
    }
  ],
  "projection": {"type": "albersUsa"},
  "mark": {"type": "geoshape", "stroke": "white"},
  "encoding": {
    "shape": {"field": "geo", "type": "geojson"},
    "strokeWidth": {
      "condition": {"param": "hoverAOR", "empty": false, "value": 1.5},
      "value": 0.6
    },
    "color": {
      "field": "totalArrests",
      "type": "quantitative",
      "scale": {"scheme": "orangered"},
      "title": "Arrests"
    },
    "tooltip": [
      {
        "field": "aor_nam",
        "title": "Area of Responsibility",
        "type": "nominal"
      },
      {
        "field": "totalArrests",
        "title": "Arrests",
        "type": "quantitative",
        "format": ","
      }
    ]
  },
  "config": {
    "font": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "numberFormat": ".0f",
    "view": {"stroke": "transparent"},
    "background": "transparent",
    "range": {
      "category": [
        "#155263",
        "#ff6f3c",
        "#ff9a3c",
        "#ffc93c",
        "#0a0a0a",
        "#8b4513"
      ]
    },
    "point": {"filled": true, "opacity": 0.95},
    "axis": {
      "labelColor": "#0a0a0a",
      "labelFontSize": 11,
      "labelFont": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "labelOpacity": 1,
      "tickColor": "#0a0a0a",
      "tickOpacity": 0.6,
      "domainColor": "#0a0a0a",
      "domainOpacity": 0.6,
      "gridColor": "#d0d0d0",
      "gridDash": [2, 2],
      "gridOpacity": 0.8,
      "title": null,
      "titleColor": "#0a0a0a",
      "titleFont": "'Besley', 'Merriweather', serif",
      "titleOpacity": 1,
      "titleFontWeight": 500,
      "tickSize": 5
    },
    "axisXDiscrete": {
      "grid": false,
      "labelAngle": 0,
      "tickCount": 10,
      "tickOpacity": 0.6,
      "title": null
    },
    "axisYDiscrete": {"ticks": false, "labelPadding": 5},
    "axisXQuantitative": {"grid": true},
    "axisYQuantitative": {
      "gridColor": "#d0d0d0",
      "gridDash": [1, 5],
      "gridOpacity": 0.8,
      "ticks": false,
      "labelPadding": 5,
      "tickCount": 8,
      "titleAngle": -90,
      "titleAlign": "center",
      "titleBaseline": "middle"
    },
    "legend": {
      "titleFont": "'Besley', 'Merriweather', serif",
      "titleFontSize": 15,
      "titleFontWeight": 500,
      "titleColor": "#0a0a0a",
      "title": null,
      "labelFont": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "labelColor": "#0a0a0a",
      "labelFontSize": 12
    },
    "title": {
      "font": "'Besley', 'Garamond', 'Georgia'",
      "fontSize": 20,
      "fontWeight": 500,
      "color": "#0a0a0a",
      "subtitleFont": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "subtitleFontSize": 14,
      "subtitleColor": "#0a0a0a",
      "anchor": "start",
      "offset": 10
    }
  }
}