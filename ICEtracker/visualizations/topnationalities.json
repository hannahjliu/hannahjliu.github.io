{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Top countries by arrests under Trump 2.0",
  "data": {
    "url": "https://raw.githubusercontent.com/hannahjliu/hannahjliu.github.io/refs/heads/main/ICEtracker/data/topcountryarrests2025.csv"
  },
  "title": {
     "text": {"expr": "excludeMexico ? 'Top nationalities of arrests in Trump 2.0 (excluding Mexico)' : 'Top nationalities of arrests in Trump 2.0'"},
    "subtitle": "Nationalities are based on citizenship."
  },
  "width": 600,
  "params": [
    {
      "name": "topN",
      "value": 20,
      "bind": {
        "input": "range",
        "min": 5,
        "max": 30,
        "step": 1,
        "name": "Number of countries:"
      }
    },
    {
      "name": "excludeMexico",
      "value": false,
      "bind": {"input": "checkbox", "name": "Exclude Mexico"}
    }
  ],
  "transform": [
    {"calculate": "toNumber(datum.Arrests)", "as": "ArrestsNum"},
    {"filter": "!excludeMexico || datum['Citizenship Country'] != 'Mexico'"},
    {
      "window": [{"op": "rank", "as": "rank"}],
      "sort": [{"field": "ArrestsNum", "order": "descending"}]
    },
    {"filter": "datum.rank <= topN"},
    {
      "joinaggregate": [
        {"op": "sum", "field": "ArrestsNum", "as": "TotalArrests"}
      ]
    },
    {
      "calculate": "datum.ArrestsNum / datum.TotalArrests",
      "as": "ShareOfArrests"
    }
  ],
  "mark": {"type": "bar", "color": "#ff6f3c"},
  "encoding": {
    "y": {
      "field": "Citizenship Country",
      "type": "nominal",
      "sort": "-x",
      "title": null
    },
    "x": {
      "field": "ArrestsNum",
      "type": "quantitative",
      "title": "Number of Arrests"
    },
    "tooltip": [
      {"field": "Citizenship Country", "type": "nominal", "title": "Country"},
      {
        "field": "ArrestsNum",
        "type": "quantitative",
        "title": "Arrests",
        "format": ","
      },
      {
        "field": "ShareOfArrests",
        "type": "quantitative",
        "title": "Share of Arrests",
        "format": ".1%"
      }
    ]
  },
  "config": {
    "font": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "numberFormat": ".0f",
    "view": {"stroke": "transparent"},
    "background": "transparent",
    "range": {
      "category": [
        "#155263",
        "#ff6f3c",
        "#ff9a3c",
        "#ffc93c",
        "#0a0a0a",
        "#8b4513"
      ]
    },
    "point": {"filled": true, "opacity": 0.95},
    "axis": {
      "labelColor": "#0a0a0a",
      "labelFontSize": 11,
      "labelFont": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "labelOpacity": 1,
      "tickColor": "#0a0a0a",
      "tickOpacity": 0.6,
      "domainColor": "#0a0a0a",
      "domainOpacity": 0.6,
      "gridColor": "#b4b4b4",
      "gridDash": [2, 2],
      "gridOpacity": 1,
      "titleColor": "#0a0a0a",
      "titleFont": "'Besley', 'Merriweather', serif",
      "titleOpacity": 1,
      "titleFontWeight": 500,
      "tickSize": 5
    },
    "axisXDiscrete": {
      "grid": false,
      "labelAngle": 0,
      "tickCount": 10,
      "tickOpacity": 0.6
    },
    "axisYDiscrete": {"ticks": false, "labelPadding": 5},
    "axisXQuantitative": {"grid": true},
    "axisYQuantitative": {
      "gridColor": "#a0a0a0",
      "gridDash": [1, 5],
      "gridOpacity": 1,
      "ticks": false,
      "labelPadding": 5,
      "tickCount": 8,
      "titleAngle": 0,
      "titleAlign": "left",
      "titleBaseline": "bottom"
    },
    "legend": {
      "titleFont": "'Besley', 'Merriweather', serif",
      "titleFontSize": 15,
      "titleFontWeight": 500,
      "titleColor": "#0a0a0a",
      "labelFont": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "labelColor": "#0a0a0a",
      "labelFontSize": 12
    },
    "title": {
      "font": "'Besley', 'Garamond', 'Georgia'",
      "fontSize": 20,
      "fontWeight": 500,
      "color": "#0a0a0a",
      "subtitleFont": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "subtitleFontSize": 14,
      "subtitleColor": "#0a0a0a",
      "anchor": "start",
      "offset": 10
    },
    "mark": {"tooltip": true}
  }
}