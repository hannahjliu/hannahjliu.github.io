{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Comparing Daily Arrest Averages of Trump 1.0 and 2.0",
  "title": {
    "text": "Daily ICE Arrest Averages",
    "subtitle": "The chart shows the seven-day rolling average of the number of daily ICE administrative arrests."
  },
  "data": {
    "url": "https://raw.githubusercontent.com/hannahjliu/hannahjliu.github.io/refs/heads/main/ICEtracker/data/dailyarrests2025.csv"
  },
  "params": [
    {
      "name": "startDate",
      "value": "2024-10-01",
      "bind": {
        "input": "date",
        "name": "Start Date:",
        "min": "2023-10-01",
        "max": "2026-03-10"
      }
    },
    {
      "name": "endDate",
      "value": "2026-03-10",
      "bind": {
        "input": "date",
        "name": "End Date:",
        "min": "2023-10-01",
        "max": "2026-03-10"
      }
    }
  ],
  "transform": [
    {
      "filter": "datum['Apprehension Date'] >= datetime(year(startDate), month(startDate), date(startDate)) && datum['Apprehension Date'] <= datetime(year(endDate), month(endDate), date(endDate))"
    }
  ],
  "height": 400,
  "width": 680,
  "layer": [
    {
      "encoding": {
        "x": {"field": "Apprehension Date", "type": "temporal"},
        "y": {
          "field": "week_rolling_avg",
          "type": "quantitative",
          "title": "Average Daily Arrests"
        },
        "tooltip": [
          {"field": "Apprehension Date", "type": "temporal", "title": "Date", "format": "%b %d, %Y"},
          {
            "field": "week_rolling_avg",
            "type": "quantitative",
            "title": "Arrests",
            "format": ".1f"
          }
        ]
      },
      "layer": [
        {"mark": {"type": "line", "strokeWidth": 2.5, "color": "#155263"}},
        {
          "transform": [{"filter": {"param": "hover", "empty": false}}],
          "mark": {"type": "point", "size": 100, "filled": true}
        }
      ]
    },
    {
      "data": {"values": [{"inauguration_date": "2025-01-20"}]},
      "mark": {
        "type": "rule",
        "color": "tomato",
        "strokeWidth": 1,
        "strokeDash": [6.4]
      },
      "encoding": {
        "x": {
          "field": "inauguration_date",
          "type": "temporal"
        }
      }
    },
    {
      "mark": {"type": "rule"},
      "encoding": {
        "x": {
          "field": "Apprehension Date",
          "type": "temporal"
        },
        "opacity": {
          "condition": {"value": 0.3, "param": "hover", "empty": false},
          "value": 0
        },
        "tooltip": [
          {
            "field": "Apprehension Date",
            "type": "temporal",
            "title": "Date",
            "format": "%b %d, %Y"
          },
          {"field": "week_rolling_avg", "title": "Arrests", "type": "quantitative", "format": ".1f"}
        ]
      },
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": ["Apprehension Date"],
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ]
    }
  ],
  "config": {
    "font": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "numberFormat": ".0f",
    "view": {"stroke": "transparent"},
    "background": "transparent",
    "range": {
      "category": [
        "#155263",
        "#ff6f3c",
        "#ff9a3c",
        "#ffc93c",
        "#0a0a0a",
        "#8b4513"
      ]
    },
    "point": {"filled": true, "opacity": 0.95},
    "axis": {
      "labelColor": "#0a0a0a",
      "labelFontSize": 11,
      "labelFont": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "labelOpacity": 1,
      "tickColor": "#0a0a0a",
      "tickOpacity": 0.6,
      "domainColor": "#0a0a0a",
      "domainOpacity": 0.6,
      "gridColor": "#bfbfbf",
      "gridDash": [2, 2],
      "gridOpacity": 0.8,
      "title": null,
      "titleColor": "#0a0a0a",
      "titleFont": "'Besley', 'Merriweather', serif",
      "titleOpacity": 1,
      "titleFontWeight": 500,
      "tickSize": 5
    },
    "axisXDiscrete": {
      "grid": false,
      "labelAngle": 0,
      "tickCount": 10,
      "tickOpacity": 0.6,
      "title": null
    },
    "axisYDiscrete": {"ticks": false, "labelPadding": 5},
    "axisXQuantitative": {"grid": true},
    "axisYQuantitative": {
      "gridColor": "#d0d0d0",
      "gridDash": [1, 5],
      "gridOpacity": 0.8,
      "ticks": false,
      "labelPadding": 5,
      "tickCount": 8,
      "titleAngle": -90,
      "titleAlign": "center",
      "titleBaseline": "middle"
    },
    "legend": {
      "titleFont": "'Besley', 'Merriweather', serif",
      "titleFontSize": 15,
      "titleFontWeight": 500,
      "titleColor": "#0a0a0a",
      "title": null,
      "labelFont": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "labelColor": "#0a0a0a",
      "labelFontSize": 12
    },
    "title": {
      "font": "'Besley', 'Garamond', 'Georgia'",
      "fontSize": 20,
      "fontWeight": 500,
      "color": "#0a0a0a",
      "subtitleFont": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "subtitleFontSize": 14,
      "subtitleColor": "#0a0a0a",
      "anchor": "start",
      "offset": 10
    },
    "mark": {"tooltip": true}
  }
}