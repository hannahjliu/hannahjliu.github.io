{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth map of Scotland showing 2024 wage data by Local Authority District using blue color scale.",
  "title": "Percent of Smokers by Local Authority in Scotland (2023)",
  "width": 400,
  "height": 500,
  "data": {
    "url": "https://raw.githubusercontent.com/jhellingsdata/RADataHub/refs/heads/main/MappingWorkshop/geo_data/LAD_SCT_2025_05.topojson",
    "format": {"type": "topojson", "feature": "object_name"}
  },
  "transform": [
    {
      "lookup": "properties.LAD25CD",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/hannahjliu/hannahjliu.github.io/refs/heads/main/data/smokersscotland2023.csv"
        },
        "key": "geo_id",
        "fields": ["value"]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 0.5
  },
  "encoding": {
    "color": {
      "field": "value",
      "type": "quantitative",
      "scale": {"scheme": "blues"},
      "title": "Cigarette Smokers (%)"
    },
    "tooltip": [
      {"field": "properties.LAD25NM", "type": "nominal", "title": "Local Authority District"},
      {"field": "value", "type": "quantitative", "title": "Cigarette Smokers (%)", "format": ",.0f"}
    ]
  },
  "projection": {
    "type": "mercator"
  }
}