{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A simple bar chart with embedded data.",
  "width": 400,
  "data": {
    "url": "data/arrestviews.csv"
  },
  "mark": {"type": "bar", "color": "coral"},
  "encoding": {
    "x": {
      "field": "characteristic",
      "type": "nominal",
      "axis": {"labelAngle": 0},
      "title": null
    },
    "y": {"field": "value", "type": "quantitative", "title": "Arrests"},
    "tooltip": [
      {"field": "characteristic", "type": "nominal", "title": "Category"},
      {"field": "value", "type": "quantitative", "title": "Arrest Numbers"},
      {"field": "percentage", "type": "quantitative", "format": ".1%", "title": "Percentage of Total"}
    ]
  },
  "params": [
    {
      "name": "SelectParam",
      "value": "gender",
      "bind": {
        "input": "select",
        "options": ["gender", "age group", "criminality"],
        "name": "Select category:"
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.view == SelectParam && datum.administration == 'Trump 1.0'"
    }
  ]
}