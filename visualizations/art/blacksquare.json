{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "https://raw.githubusercontent.com/RDeconomist/RDeconomist.github.io/main/charts/colour/dataKlein.csv"
  },
  "title": {
    "text": "Kazimir Malevich",
    "subtitle": "Black Square (1915)",
    "subtitleFontStyle": "italic",
    "subtitleFontSize": 10,
    "anchor": "start",
    "color": "black"
  },
  "config": {"background": "#FAFAFA"},
  "height": 300,
  "width": 300,
  "layer": [
    {
      "mark": {"type": "rect", "fill": "#D7E1D6", "opacity": 1},
      "encoding": {
        "x": {"datum": 0, "type": "quantitative", "axis": null},
        "x2": {"datum": 300},
        "y": {"datum": 0, "type": "quantitative", "axis": null},
        "y2": {"datum": 300}
      }
    },
    {
      "mark": {"type": "rect", "fill": "#0C1415", "opacity": 1},
      "encoding": {
        "x": {"datum": 50, "type": "quantitative", "axis": null},
        "x2": {"datum": 250},
        "y": {"datum": 50, "type": "quantitative", "axis": null},
        "y2": {"datum": 250}
      }
    }
  ]
}