{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 650,
  "height": 300,
  "data": {
    "url": "https://raw.githubusercontent.com/hannahjliu/hannahjliu.github.io/refs/heads/main/data/detainees1925.csv"
  },
  "background": "#D2CCD9",
  "transform": [
    {
      "filter": "year(datum.Date) > 2024 || (year(datum.Date) == 2024 && month(datum.Date) >= 10)"
    }
  ],
  "title": {
    "text": "Figure 2. Population in ICE Detention, 2024-25",
    "anchor": "start"
  },
  "layer": [
    {
      "mark": {"type": "line", "color": "#4BABC5"},
      "encoding": {
        "x": {
          "field": "Date",
          "type": "temporal",
          "title": "",
          "axis": {"format": "%b %Y", "grid": false}
        },
        "y": {
          "field": "Total",
          "type": "quantitative",
          "title": " ",
          "axis": {"grid": false}
        }
      }
    }
  ],
  "config": { 
    }
}