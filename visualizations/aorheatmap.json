{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 560,
  "height": 300,
  "title": {
    "text": "ICE Arrests by Area of Responsibility and Weeks Since Inauguration",
    "fontSize": 16,
    "fontWeight": "bold"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/hannahjliu/hannahjliu.github.io/refs/heads/main/data/arrests_heatmap_data.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum.weeks_since_inauguration)",
      "as": "week_number"
    }
  ],
  "config": {"view": {"strokeWidth": 0, "step": 20}, "axis": {"domain": false}},
  "mark": {"type": "rect", "tooltip": true},
  "encoding": {
    "x": {
      "field": "weeks_since_inauguration",
      "type": "ordinal",
      "title": "Weeks Since Inauguration",
      "axis": {"labelAngle": 0, "labelFontSize": 9},
      "sort": {"field": "week_number", "op": "min"}
    },
    "y": {
      "field": "Apprehension AOR",
      "type": "nominal",
      "title": "Area of Responsibility",
      "sort": "-color",
      "axis": {"labelFontSize": 9}
    },
    "color": {
      "field": "arrests",
      "type": "quantitative",
      "scale": {"scheme": "blues"},
      "legend": {"title": "Number of Arrests", "orient": "right"}
    },
    "tooltip": [
      {"field": "Apprehension AOR", "type": "nominal", "title": "AOR"},
      {"field": "weeks_since_inauguration", "type": "ordinal", "title": "Week"},
      {"field": "arrests", "type": "quantitative", "title": "Arrests"}
    ]
  }
}